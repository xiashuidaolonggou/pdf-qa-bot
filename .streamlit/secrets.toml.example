# Secrets 配置示例
#
# 用法（二选一）：
# 1) Streamlit Cloud：部署时在 Advanced settings -> Secrets 中粘贴下面这一行（填真实 Key）。
# 2) 本地运行：把本文件复制为 .streamlit/secrets.toml 后填真实 Key。
#    secrets.toml 已被 .gitignore 忽略，禁止把真实 Key 提交到仓库。
#
# 应用启动只需要这一项；其余参数在 config.py 中都有默认值，一般不用填。

GEMINI_API_KEY = "在这里填你的 Gemini API Key"

# 以下为可选覆盖项（不填则用 config.py 默认值）：
# GEMINI_MODEL = "gemini-3.6-flash"
# EMBEDDING_MODEL = "models/gemini-embedding-2"
# CHUNK_SIZE = "1000"
# CHUNK_OVERLAP = "200"
# TOP_K = "6"
